# 乐曼同传 Leman Translate - Environment Configuration
# Copy this file to .env and fill in your values

# ==================== API Keys ====================
# Gemini API Key (for translation service)
GEMINI_API_KEY=your_gemini_api_key_here

# ==================== Douyin Authentication ====================
# Login to https://live.douyin.com in browser
# Press F12 -> Application -> Cookies
# Copy the full cookie string into DY_LIVE_COOKIES
DY_LIVE_COOKIES=your_dy_live_cookies_here

# Optional: DY_COOKIE for general Douyin API access
DY_COOKIE=your_dy_cookie_here

# ==================== Whisper Settings ====================
# Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# Device: cpu, cuda, cuda:0
WHISPER_DEVICE=cuda

# ==================== Audio Settings ====================
# Sample rate for ASR (Hz)
AUDIO_SAMPLE_RATE=16000

# Chunk size for audio streaming (bytes)
AUDIO_CHUNK_SIZE=3200

# ==================== Backend Server ====================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ==================== Frontend Server ====================
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
