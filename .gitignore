# ========================================
# 乐曼同传小助手 - 源代码与打包产物隔离
# ========================================

# 1. 隔离所有打包产物与构建临时文件
/output/
*.exe
*.dist
*.build
*.asar

# 2. Python 依赖与编译缓存
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/

# 3. Node.js / Electron / Vite 依赖与依赖包
node_modules/
.vite/
npm-debug.log*
yarn-debug.log*

# 4. 本地用户配置与敏感文件
config.json
.env
.env.local
*.log
cleanup_report_*

# 5. 忽略临时 MD 报告，但保留 prompts 目录下的同传灵魂文件
*_2026*.md
!README.md
!**/prompts/*.md
!**/prompts/**/*.md

# 6. IDE / 编辑器配置文件
.vscode/
.idea/
*.swp
*.swo

# 7. OS 操作系统临时文件
.DS_Store
Thumbs.db

# 8. 前端构建产物（已在 output/ 隔离，额外防护）
frontend/dist/
frontend/dist-electron/
frontend/release/

# 9. 后端构建产物（已在 output/ 隔离，额外防护）
backend/dist/
backend/build/
backend/*.spec
# Build artifacts
build/
backend_engine.spec
output/

# 10. 云端授权服务（独立服务，不打包进客户端）
server/
server/*.db
server/__pycache__/

# Windows 保留设备名垃圾文件（cmd 重定向误产）
nul
